{
  "name": "storybook-app",
  "version": "0.0.0",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\" && storybook build -o dist/storybook",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "format:check": "prettier --check \"src/**/*.{scss,ts,tsx,js,jsx,html,json}\"",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{js,jsx,html,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@progress/kendo-licensing": "^1.11.2",
    "@progress/kendo-react-dateinputs": "^15.0.0",
    "@progress/kendo-react-dropdowns": "^15.0.0",
    "@progress/kendo-react-inputs": "^15.0.0",
    "@progress/kendo-react-intl": "^15.0.0",
    "@progress/kendo-theme-default": "^14.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.3",
    "sass": "^1.93.0",
    "storybook": "^10.4.6",
    "stylelint": "17.14.0",
    "stylelint-config-standard-scss": "^17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.0"
  }
}
