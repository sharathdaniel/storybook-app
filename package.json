{
  "name": "storybook-app",
  "version": "0.0.0",
  "license": "0BSD",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "format:check": "prettier --check \"src/**/*.{scss,ts,tsx,js,jsx,html,json}\"",
    "prepare": "husky",
    "storybook": "ng run storybook:storybook",
    "build-storybook": "ng run storybook:build-storybook"
  },
  "lint-staged": {
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "src/**/*.{ts,tsx,js,jsx,html,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/forms": "^21.2.6",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@progress/kendo-angular-dateinputs": "^24.1.0",
    "@progress/kendo-angular-dropdowns": "^24.1.0",
    "@progress/kendo-angular-inputs": "^24.1.0",
    "@progress/kendo-licensing": "^1.11.2",
    "@progress/kendo-theme-default": "^14.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.6",
    "@angular-devkit/build-angular": "^21.2.6",
    "@angular-devkit/core": "^21.2.6",
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@compodoc/compodoc": "^1.2.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/angular": "^10.4.6",
    "@types/jasmine": "~5.1.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "storybook": "^10.4.6",
    "stylelint": "17.13.0",
    "stylelint-config-standard-scss": "^17",
    "typescript": "~5.9.3"
  }
}
