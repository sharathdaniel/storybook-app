            "templateData": "<div class=\"app-c-page-scroll u-scrollbar\">\n  <h1 class=\"u-mb-2\">Components</h1>\n  <p class=\"u-mb-4\">\n    A minimal set of reference primitives built on the StyleBase token system. Fork them, extend\n    them, or use them as a blueprint for your own components.\n  </p>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Buttons</h2>\n\n    <h3 class=\"u-mb-2\">Primary</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-sm\">Small</button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-md\">Medium</button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-lg\">Large</button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-xl\">Extra Large</button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-md\" disabled>Disabled</button>\n    </div>\n\n    <h3 class=\"u-mb-2\">Secondary</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-sm\">Small</button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\">Medium</button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-lg\">Large</button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-xl\">Extra Large</button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\" disabled>Disabled</button>\n    </div>\n\n    <h3 class=\"u-mb-2\">Tertiary</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-sm\">Small</button>\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-md\">Medium</button>\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-lg\">Large</button>\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-xl\">Extra Large</button>\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-md\" disabled>Disabled</button>\n    </div>\n\n    <h3 class=\"u-mb-2\">With Leading Icon</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-sm\">\n        <app-icon name=\"icon-home\" class=\"app-c-icon\"></app-icon>\n        Small\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-md\">\n        <app-icon name=\"icon-home\" class=\"app-c-icon\"></app-icon>\n        Medium\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-lg\">\n        <app-icon name=\"icon-home\" class=\"app-c-icon\"></app-icon>\n        Large\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-xl\">\n        <app-icon name=\"icon-home\" class=\"app-c-icon\"></app-icon>\n        Extra Large\n      </button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\">\n        <app-icon name=\"icon-user\" class=\"app-c-icon\"></app-icon>\n        Profile\n      </button>\n      <button class=\"app-c-btn app-c-btn-tertiary app-c-btn-md\">\n        <app-icon name=\"icon-home\" class=\"app-c-icon\"></app-icon>\n        Home\n      </button>\n    </div>\n\n    <h3 class=\"u-mb-2\">With Trailing Icon</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-sm\">\n        Small\n        <app-icon name=\"icon-user\" class=\"app-c-icon\"></app-icon>\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-md\">\n        Medium\n        <app-icon name=\"icon-user\" class=\"app-c-icon\"></app-icon>\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-lg\">\n        Large\n        <app-icon name=\"icon-user\" class=\"app-c-icon\"></app-icon>\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-xl\">\n        Extra Large\n        <app-icon name=\"icon-user\" class=\"app-c-icon\"></app-icon>\n      </button>\n    </div>\n\n    <h3 class=\"u-mb-2\">Icon Buttons</h3>\n    <div class=\"demo-row\">\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-icon-xs\" aria-label=\"Extra small icon\">\n        XS\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-icon-sm\" aria-label=\"Small icon\">\n        S\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-icon-md\" aria-label=\"Medium icon\">\n        M\n      </button>\n      <button class=\"app-c-btn app-c-btn-primary app-c-btn-icon-lg\" aria-label=\"Large icon\">\n        L\n      </button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-icon-xs\" aria-label=\"Extra small icon\">\n        XS\n      </button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-icon-sm\" aria-label=\"Small icon\">\n        S\n      </button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-icon-md\" aria-label=\"Medium icon\">\n        M\n      </button>\n      <button class=\"app-c-btn app-c-btn-secondary app-c-btn-icon-lg\" aria-label=\"Large icon\">\n        L\n      </button>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Text Fields</h2>\n\n    <h3 class=\"u-mb-2\">Input Sizes</h3>\n    <div class=\"demo-stack\">\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-sm\"\n        placeholder=\"Small input\"\n        aria-label=\"Small input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-md\"\n        placeholder=\"Medium input\"\n        aria-label=\"Medium input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-lg\"\n        placeholder=\"Large input\"\n        aria-label=\"Large input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-xl\"\n        placeholder=\"Extra Large input\"\n        aria-label=\"Extra Large input\"\n      />\n    </div>\n\n    <h3 class=\"u-mb-2\">States</h3>\n    <div class=\"demo-stack\">\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-md\"\n        value=\"Default\"\n        aria-label=\"Default input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-md app-c-textfield-error\"\n        value=\"Error state\"\n        aria-label=\"Error input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-md\"\n        readonly\n        value=\"Readonly\"\n        aria-label=\"Readonly input\"\n      />\n      <input\n        type=\"text\"\n        class=\"app-c-textfield app-c-textfield-md\"\n        disabled\n        value=\"Disabled\"\n        aria-label=\"Disabled input\"\n      />\n    </div>\n\n    <h3 class=\"u-mb-2\">Textarea</h3>\n    <div class=\"demo-stack\">\n      <textarea\n        class=\"app-c-textfield app-c-textarea\"\n        rows=\"3\"\n        placeholder=\"Write something...\"\n        aria-label=\"Default textarea\"\n      ></textarea>\n      <textarea\n        class=\"app-c-textfield app-c-textarea app-c-textfield-error\"\n        rows=\"3\"\n        placeholder=\"Error textarea...\"\n        aria-label=\"Error textarea\"\n      ></textarea>\n      <textarea\n        class=\"app-c-textfield app-c-textarea\"\n        rows=\"3\"\n        disabled\n        placeholder=\"Disabled textarea...\"\n        aria-label=\"Disabled textarea\"\n      ></textarea>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Checkboxes</h2>\n\n    <div class=\"demo-row\">\n      <label class=\"app-c-checkbox\">\n        <input type=\"checkbox\" aria-label=\"Unchecked\" />\n        <span class=\"app-c-checkbox-text\">Unchecked</span>\n      </label>\n\n      <label class=\"app-c-checkbox\">\n        <input type=\"checkbox\" checked aria-label=\"Checked\" />\n        <span class=\"app-c-checkbox-text\">Checked</span>\n      </label>\n\n      <label class=\"app-c-checkbox\">\n        <input type=\"checkbox\" disabled aria-label=\"Disabled\" />\n        <span class=\"app-c-checkbox-text\">Disabled</span>\n      </label>\n\n      <label class=\"app-c-checkbox\">\n        <input type=\"checkbox\" checked disabled aria-label=\"Checked disabled\" />\n        <span class=\"app-c-checkbox-text\">Checked disabled</span>\n      </label>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Radio Buttons</h2>\n\n    <div class=\"demo-row\">\n      <label class=\"app-c-radio\">\n        <input type=\"radio\" name=\"demo-radio\" value=\"a\" checked aria-label=\"Option A\" />\n        <span class=\"app-c-radio-text\">Option A</span>\n      </label>\n\n      <label class=\"app-c-radio\">\n        <input type=\"radio\" name=\"demo-radio\" value=\"b\" aria-label=\"Option B\" />\n        <span class=\"app-c-radio-text\">Option B</span>\n      </label>\n\n      <label class=\"app-c-radio\">\n        <input type=\"radio\" name=\"demo-radio\" value=\"c\" aria-label=\"Option C\" />\n        <span class=\"app-c-radio-text\">Option C</span>\n      </label>\n\n      <label class=\"app-c-radio\">\n        <input type=\"radio\" name=\"demo-disabled\" value=\"d\" disabled aria-label=\"Disabled\" />\n        <span class=\"app-c-radio-text\">Disabled</span>\n      </label>\n\n      <label class=\"app-c-radio\">\n        <input\n          type=\"radio\"\n          name=\"demo-disabled-checked\"\n          value=\"e\"\n          checked\n          disabled\n          aria-label=\"Checked disabled\"\n        />\n        <span class=\"app-c-radio-text\">Checked disabled</span>\n      </label>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Toggle Switches</h2>\n\n    <div class=\"demo-row\">\n      <label class=\"app-c-toggle\">\n        <input type=\"checkbox\" aria-label=\"Off\" />\n        <span class=\"app-c-toggle-text\">Off</span>\n      </label>\n\n      <label class=\"app-c-toggle\">\n        <input type=\"checkbox\" checked aria-label=\"On\" />\n        <span class=\"app-c-toggle-text\">On</span>\n      </label>\n\n      <label class=\"app-c-toggle\">\n        <input type=\"checkbox\" disabled aria-label=\"Disabled off\" />\n        <span class=\"app-c-toggle-text\">Disabled</span>\n      </label>\n\n      <label class=\"app-c-toggle\">\n        <input type=\"checkbox\" checked disabled aria-label=\"Disabled on\" />\n        <span class=\"app-c-toggle-text\">Disabled on</span>\n      </label>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Badges</h2>\n\n    <div class=\"demo-row\">\n      <span class=\"app-c-badge\">Neutral</span>\n      <span class=\"app-c-badge app-c-badge-success\">Success</span>\n      <span class=\"app-c-badge app-c-badge-error\">Error</span>\n      <span class=\"app-c-badge app-c-badge-warning\">Warning</span>\n      <span class=\"app-c-badge app-c-badge-info\">Info</span>\n    </div>\n  </section>\n\n  <section class=\"demo-section\">\n    <h2 class=\"u-mb-3\">Groups</h2>\n\n    <h3 class=\"u-mb-2\">Button Group</h3>\n    <div class=\"demo-row\">\n      <div class=\"app-c-btn-group\">\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-sm\">Left</button>\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-sm\">Center</button>\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-sm\">Right</button>\n      </div>\n      <div class=\"app-c-btn-group\">\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\">Left</button>\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\">Center</button>\n        <button class=\"app-c-btn app-c-btn-secondary app-c-btn-md\">Right</button>\n      </div>\n    </div>\n\n    <h3 class=\"u-mb-2\">Input Group</h3>\n    <div class=\"demo-stack\">\n      <div class=\"app-c-input-group\">\n        <input\n          type=\"text\"\n          class=\"app-c-textfield app-c-textfield-md\"\n          placeholder=\"First name\"\n          aria-label=\"First name\"\n        />\n        <input\n          type=\"text\"\n          class=\"app-c-textfield app-c-textfield-md\"\n          placeholder=\"Last name\"\n          aria-label=\"Last name\"\n        />\n      </div>\n    </div>\n\n    <h3 class=\"u-mb-2\">Mixed (Input + Button)</h3>\n    <div class=\"demo-stack\">\n      <div class=\"app-c-input-group\">\n        <input\n          type=\"text\"\n          class=\"app-c-textfield app-c-textfield-md\"\n          placeholder=\"Search...\"\n          aria-label=\"Search\"\n        />\n        <button class=\"app-c-btn app-c-btn-primary app-c-btn-md\">Search</button>\n      </div>\n    </div>\n  </section>\n</div>\n"
